    {"text": "@log @log:src/app.js @log:../..", "anchors": [["log", "@log"], ["log", "@log:src/app.js"], ["log", "@log:../.."]]},
    {"text": "@show:HEAD~1 @show:HEAD@{1} @show:@{u}", "anchors": [["show", "@show:HEAD~1"], ["show", "@show:HEAD@{1}"], ["show", "@show:@{u}"]]},
    {"text": "@turn:2 @turn:last", "anchors": [["turn", "@turn:2"], ["turn", "@turn:last"]]},
    {"text": "mail a@src/app.js x@y.com @missing.js @src/nope/ email@diff", "anchors": []},
    {"text": "@show:-x @turn:x @a.py:0 @a.py:0-3 @a.py:5-2", "anchors": []},
    {"text": "@a.py;y @a.py|z @a.py! @a.py?", "anchors": [["file", "@a.py"], ["file", "@a.py"]]},
    {"text": "`@a.py` \"@server.js\" '@a.py:1'", "anchors": [["file", "@server.js"], ["line", "@a.py:1"]]},
    {"text": "@src/app.js:1-2]. @public/)", "anchors": [["range", "@src/app.js:1-2"], ["dir", "@public/"]]}
