#!/usr/bin/env python3
"""Claude Code hook entry point: imports only what the gate needs (it runs on
every worker tool call, so startup time matters)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from aic.hook import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
